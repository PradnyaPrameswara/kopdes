---
// src/pages/daftar.astro
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import { siteConfig } from '@/data/site.config';
---

<Layout
  title={`Pendaftaran Anggota - ${siteConfig.name}`}
  description="Formulir resmi pendaftaran anggota Koperasi Merah Putih. Bergabung bersama 1.200+ warga desa untuk mendapatkan sembako bersubsidi dan bagi hasil SHU tahunan."
>
  <Header />

  <section class="py-12 sm:py-16 md:py-20 bg-surface border-b border-border/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb & Pretitle -->
      <nav class="flex items-center gap-2 text-xs text-muted mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-red transition-colors">Beranda</a>
        <span>/</span>
        <a href="/keanggotaan" class="hover:text-brand-red transition-colors">Keanggotaan</a>
        <span>/</span>
        <span class="text-ink font-semibold">Formulir Pendaftaran</span>
      </nav>

      <!-- Page Header -->
      <div class="mb-10 text-center sm:text-left">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-brand-red/20 bg-white text-brand-red text-xs font-semibold mb-3 shadow-2xs">
          <span class="size-2 rounded-full bg-brand-red"></span>
          <span>Registrasi Anggota Baru</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-[#065366] tracking-tight leading-tight">
          Pendaftaran Anggota Koperasi Merah Putih
        </h1>
        <p class="mt-3 text-sm sm:text-base md:text-lg text-muted leading-relaxed max-w-2xl">
          Lengkapi data identitas di bawah ini untuk menjadi anggota resmi. Seluruh anggota berhak atas sembako bersubsidi, layanan kesehatan desa, dan dividen SHU tahunan.
        </p>
      </div>

      <!-- Registration Form Card -->
      <div class="bg-white rounded-[20px] p-6 sm:p-8 md:p-10 border border-border/80 shadow-sm">
        <form
          action={`https://wa.me/${siteConfig.whatsappNumber}`}
          method="GET"
          target="_blank"
          class="space-y-6"
          id="registration-form"
        >
          <!-- Section 1: Identitas Pribadi -->
          <div>
            <h2 class="text-base sm:text-lg font-bold text-[#065366] pb-3 mb-4 border-b border-border/60 flex items-center gap-2">
              <span class="flex size-6 rounded-full bg-brand-red text-white text-xs font-bold items-center justify-center">1</span>
              <span>Identitas Kependudukan Desa</span>
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
              <div>
                <label for="nama" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
                  Nama Lengkap (Sesuai KTP) <span class="text-brand-red">*</span>
                </label>
                <input
                  type="text"
                  id="nama"
                  name="nama"
                  required
                  placeholder="Masukkan nama lengkap"
                  class="w-full px-4 py-2.5 rounded-xl border border-border bg-surface/50 text-ink text-sm focus:outline-none focus:ring-2 focus:ring-[#065366] focus:bg-white transition-all"
                />
              </div>

              <div>
                <label for="nik" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
                  Nomor Induk Kependudukan (NIK 16 Digit) <span class="text-brand-red">*</span>
                </label>
                <input
                  type="text"
                  id="nik"
                  name="nik"
                  pattern="[0-9]{16}"
                  maxlength="16"
                  required
                  placeholder="Contoh: 3201xxxxxxxxxxxx"
                  class="w-full px-4 py-2.5 rounded-xl border border-border bg-surface/50 text-ink text-sm focus:outline-none focus:ring-2 focus:ring-[#065366] focus:bg-white transition-all font-mono"
                />
              </div>

              <div>
                <label for="whatsapp" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
                  Nomor WhatsApp / HP Aktif <span class="text-brand-red">*</span>
                </label>
                <input
                  type="tel"
                  id="whatsapp"
                  name="whatsapp"
                  required
                  placeholder="Contoh: 081234567890"
                  class="w-full px-4 py-2.5 rounded-xl border border-border bg-surface/50 text-ink text-sm focus:outline-none focus:ring-2 focus:ring-[#065366] focus:bg-white transition-all font-mono"
                />
              </div>

              <div>
                <label for="profesi" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
                  Kategori Warga / Profesi Utama <span class="text-brand-red">*</span>
                </label>
                <select
                  id="profesi"
                  name="profesi"
                  required
                  class="w-full px-4 py-2.5 rounded-xl border border-border bg-surface/50 text-ink text-sm focus:outline-none focus:ring-2 focus:ring-[#065366] focus:bg-white transition-all"
                >
                  <option value="">Pilih Kategori Warga</option>
                  <option value="Petani / Pekebun">Petani / Pekebun</option>
                  <option value="Peternak / Perikanan">Peternak / Perikanan</option>
                  <option value="Ibu Rumah Tangga">Ibu Rumah Tangga</option>
                  <option value="Pelaku UMKM / Pedagang Desa">Pelaku UMKM / Pedagang Desa</option>
                  <option value="Pekerja / Karyawan">Pekerja / Karyawan</option>
                  <option value="Warga Umum Desa">Warga Umum Desa</option>
                </select>
              </div>
            </div>

            <div class="mt-4">
              <label for="alamat" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
                Alamat Domisili Desa (Dusun / RT / RW) <span class="text-brand-red">*</span>
              </label>
              <input
                type="text"
                id="alamat"
                name="alamat"
                required
                placeholder="Contoh: Dusun Sukamaju, RT 02 / RW 01, Desa Makmur"
                class="w-full px-4 py-2.5 rounded-xl border border-border bg-surface/50 text-ink text-sm focus:outline-none focus:ring-2 focus:ring-[#065366] focus:bg-white transition-all"
              />
            </div>
          </div>

          <!-- Section 2: Ketentuan Simpanan Koperasi -->
          <div class="pt-4">
            <h2 class="text-base sm:text-lg font-bold text-[#065366] pb-3 mb-4 border-b border-border/60 flex items-center gap-2">
              <span class="flex size-6 rounded-full bg-brand-red text-white text-xs font-bold items-center justify-center">2</span>
              <span>Ketentuan Simpanan Pokok &amp; Simpanan Wajib</span>
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="p-4 rounded-xl bg-surface border border-border">
                <span class="text-xs font-bold uppercase text-muted block">Simpanan Pokok (Dibayar 1 Kali)</span>
                <span class="text-xl sm:text-2xl font-black text-brand-red mt-1 block">Rp 50.000</span>
                <p class="text-xs text-muted mt-1 leading-relaxed">
                  Modal penyertaan awal anggota. Dapat diambil kembali apabila mengundurkan diri secara resmi.
                </p>
              </div>

              <div class="p-4 rounded-xl bg-surface border border-border">
                <span class="text-xs font-bold uppercase text-muted block">Simpanan Wajib (Per Bulan)</span>
                <span class="text-xl sm:text-2xl font-black text-brand-red mt-1 block">Rp 15.000</span>
                <p class="text-xs text-muted mt-1 leading-relaxed">
                  Tabungan rutin anggota sebagai dasar perhitungan pembagian porsi dividen SHU tahunan.
                </p>
              </div>
            </div>

            <div class="mt-4 flex items-start gap-3 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs leading-relaxed">
              <svg class="size-5 shrink-0 text-emerald-700 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
              <div>
                <span class="font-bold block">Jaminan Keamanan &amp; Transparansi:</span>
                Seluruh dana simpanan tercatat dalam buku kas digital koperasi yang diaudit berkala dan dipertanggungjawabkan dalam Rapat Anggota Tahunan (RAT).
              </div>
            </div>
          </div>

          <!-- Section 3: Persetujuan & Tombol Submit -->
          <div class="pt-4 border-t border-border/80">
            <div class="flex items-start gap-3 mb-6">
              <input
                type="checkbox"
                id="persetujuan"
                required
                class="size-4.5 rounded text-brand-red focus:ring-brand-red border-border mt-0.5"
              />
              <label for="persetujuan" class="text-xs text-muted leading-relaxed">
                Saya menyatakan bahwa data yang diisikan adalah benar dan bersedia mematuhi Anggaran Dasar / Anggaran Rumah Tangga (AD/ART) Koperasi Merah Putih demi kemakmuran bersama warga desa.
              </label>
            </div>

            <button
              type="submit"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-[10px] bg-[#065366] hover:bg-[#044352] text-white font-bold text-sm sm:text-base shadow-sm hover:shadow-md transition-all min-h-[48px]"
            >
              <span>Kirim Pendaftaran via WhatsApp</span>
              <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script is:inline>
  const form = document.getElementById('registration-form');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const nama = document.getElementById('nama')?.value || '';
      const nik = document.getElementById('nik')?.value || '';
      const wa = document.getElementById('whatsapp')?.value || '';
      const profesi = document.getElementById('profesi')?.value || '';
      const alamat = document.getElementById('alamat')?.value || '';

      const text = `Halo Pengurus Koperasi Merah Putih, saya ingin mendaftar menjadi anggota resmi koperasi dengan data berikut:%0A%0A- Nama: ${encodeURIComponent(nama)}%0A- NIK: ${encodeURIComponent(nik)}%0A- No. HP/WA: ${encodeURIComponent(wa)}%0A- Profesi: ${encodeURIComponent(profesi)}%0A- Alamat: ${encodeURIComponent(alamat)}%0A%0AMohon instruksi selanjutnya untuk verifikasi dan penyetoran simpanan pokok. Terima kasih.`;

      window.open(`https://wa.me/6281234567890?text=${text}`, '_blank', 'noopener,noreferrer');
    });
  }
</script>
