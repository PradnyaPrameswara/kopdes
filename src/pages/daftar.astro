---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/sections/Header.astro';
import PageIntro from '@/components/sections/PageIntro.astro';
import Footer from '@/components/sections/Footer.astro';
import { siteConfig } from '@/data/site.config';

const guidance = [
  {
    number: '01',
    title: 'Cari koperasi di wilayah Anda',
    detail: 'Konfirmasikan nama, alamat, dan kontak pengurus koperasi melalui kanal desa atau kelurahan setempat.',
  },
  {
    number: '02',
    title: 'Pastikan persyaratan resmi',
    detail: 'Tanyakan keanggotaan, dokumen yang diperlukan, serta ketentuan simpanan berdasarkan anggaran dasar koperasi setempat.',
  },
  {
    number: '03',
    title: 'Daftar melalui pengurus terverifikasi',
    detail: 'Berikan dokumen pribadi hanya lewat prosedur resmi, setelah memastikan identitas dan kewenangan petugas.',
  },
];
---
<Layout
  title={`Informasi Pendaftaran - ${siteConfig.name}`}
  description="Panduan awal untuk mengetahui persyaratan dan prosedur pendaftaran anggota koperasi desa."
>
  <Header />
  <PageIntro title="Mari Bergabung" description="Pelajari langkah awal menjadi anggota koperasi desa yang sesuai dengan wilayah Anda." />
  <section class="retro-section retro-section-paper" aria-labelledby="register-title">
    <div class="retro-page-container retro-registration">
      <div class="retro-registration-intro">
        <p class="retro-eyebrow">Informasi Keanggotaan</p>
        <h2 id="register-title" class="retro-section-title">Tumbuh Bersama Desa</h2>
        <p>Setiap koperasi mempunyai pengurus, ketentuan keanggotaan, dan prosedur verifikasi masing-masing. Pastikan informasi tersebut sebelum menyerahkan identitas atau melakukan pembayaran apa pun.</p>
      </div>
      <ol class="retro-registration-steps">
        {guidance.map((step) => (
          <li>
            <span class="retro-registration-number" aria-hidden="true">{step.number}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.detail}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="retro-registration-notice" role="note">
        <h3>Perlindungan Data Pribadi</h3>
        <p>Website konsep ini belum menerima pendaftaran online. Jangan mengirim NIK, foto KTP, atau dokumen pribadi ke nomor WhatsApp contoh maupun melalui tautan yang belum terverifikasi.</p>
      </div>
      <div class="retro-actions">
        <a class="retro-button retro-button-red" href="/keanggotaan">Pelajari Keanggotaan</a>
        <a class="retro-button retro-button-outline" href="/faq">Lihat Tanya Jawab</a>
      </div>
    </div>
  </section>
  <Footer />
</Layout>
