---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import { Image } from 'astro:assets';
import prabowoPortrait from '@/assets/photos/presiden-prabowo-hormat.webp';
import { cooperativeGallery, storefrontHero } from '@/data/visual-media';

const featuredPhotos = cooperativeGallery;

const values = [
  { number: '01', title: 'Gotong Royong', description: 'Membangun usaha bersama agar manfaat ekonomi kembali kepada masyarakat desa.' },
  { number: '02', title: 'Akses Kebutuhan Pokok', description: 'Mendekatkan penyediaan kebutuhan rumah tangga dan layanan yang dibutuhkan warga.' },
  { number: '03', title: 'Dari Petani untuk Desa', description: 'Memperkuat peluang pemasaran hasil pertanian dan produk usaha mikro setempat.' },
];

const units = [
  { title: 'Gerai Sembako', description: 'Kebutuhan harian dan produk pangan bagi masyarakat.', url: '/gerai' },
  { title: 'Layanan Kesehatan', description: 'Informasi model apotek serta klinik desa.', url: '/gerai' },
  { title: 'Pangan & Pergudangan', description: 'Rantai pasok dan dukungan untuk hasil tani.', url: '/gerai' },
  { title: 'Keanggotaan', description: 'Cara bergabung dan mengenali prinsip koperasi.', url: '/keanggotaan' },
];
---
<Layout
  title="Koperasi Merah Putih — Dari Desa, Untuk Indonesia"
  description="Mengenal Koperasi Desa/Kelurahan Merah Putih, gotong royong, unit usaha, dan kegiatan ekonomi masyarakat desa."
>
  <Header />

  <div class="retro-home">
    <section class="retro-welcome" aria-labelledby="welcome-heading">
      <div class="retro-page-container">
        <h1 id="welcome-heading" class="retro-welcome-heading">Selamat Datang!</h1>
        <div class="retro-welcome-grid">
          <div class="retro-welcome-text">
            <p class="retro-lead">
              Kebutuhan warga. Hasil usaha desa. Semangat gotong royong.
              Semua tumbuh bersama melalui Koperasi Merah Putih.
            </p>
            <p class="retro-welcome-detail">
              Tempat bagi masyarakat untuk mengenal gerai kebutuhan pokok,
              layanan koperasi, dan peluang ekonomi yang dibangun dari desa.
              Selamat datang di gerakan ekonomi rakyat.
            </p>
            <div class="retro-promise">
              <span class="retro-promise-star" aria-hidden="true">★</span>
              <p>Bersama Koperasi Merah Putih, desa bergerak maju.</p>
            </div>
            <p class="retro-welcome-sign">Bersama membangun ekonomi desa</p>
            <div class="retro-actions">
              <a href="/tentang" class="retro-button retro-button-red">Kenali Koperasi</a>
              <a href="/keanggotaan" class="retro-button retro-button-outline">Cara Bergabung</a>
            </div>
          </div>

          <figure class="retro-president-figure">
            <Image
              src={prabowoPortrait}
              alt="Foto dokumentasi Presiden Prabowo Subianto"
              width={600}
              class="retro-president-photo"
              loading="eager"
            />
            <figcaption class="retro-portrait-caption">
              <strong>Prabowo Subianto</strong>
              <span>Presiden Republik Indonesia</span>
              <small>Foto dokumentasi · Bukan kutipan atau dukungan personal terhadap situs ini</small>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="sejarah" class="retro-section retro-section-paper" aria-labelledby="history-heading">
      <div class="retro-page-container retro-story-grid">
        <div class="retro-story-copy">
          <p class="retro-eyebrow">Mengenal Kami</p>
          <h2 id="history-heading" class="retro-section-title">Sejarah Kami</h2>
          <div class="retro-red-rule" aria-hidden="true"></div>
          <p>
            Koperasi Desa/Kelurahan Merah Putih berkembang sebagai bagian dari inisiatif
            memperkuat ekonomi masyarakat melalui kerja sama, akses layanan,
            dan pemanfaatan potensi lokal.
          </p>
          <p>
            Setiap desa memiliki kebutuhan dan kekuatan yang berbeda.
            Karena itulah gerai serta layanan koperasi harus tumbuh mengikuti
            keadaan dan pengelolaan di wilayah masing-masing.
          </p>
          <a class="retro-text-link" href="/tentang">Baca kisah kami <span aria-hidden="true">›</span></a>
        </div>
        <figure class="retro-story-photo">
          <img
            src={featuredPhotos[0].image}
            alt={featuredPhotos[0].alt}
            data-documented-image
            data-fallback-src={storefrontHero.image}
            data-fallback-alt={storefrontHero.alt}
            data-fallback-source={storefrontHero.source}
            data-fallback-credit={storefrontHero.credit}
            width="720"
            height="480"
            loading="lazy"
            decoding="async"
          />
          <figcaption>Gerai Koperasi Merah Putih Bentangan · <a href={featuredPhotos[0].source} target="_blank" rel="noopener noreferrer">{featuredPhotos[0].credit}</a></figcaption>
        </figure>
      </div>
    </section>

    <section id="nilai" class="retro-section retro-section-values" aria-labelledby="values-heading">
      <div class="retro-page-container">
        <p class="retro-eyebrow retro-center">Apa yang Kami Percaya</p>
        <h2 id="values-heading" class="retro-section-title retro-center">Budaya &amp; Nilai Kami</h2>
        <p class="retro-section-intro">Koperasi hadir untuk memberdayakan masyarakat, dengan prinsip saling membantu, transparansi, dan manfaat bersama.</p>
        <div class="retro-values-grid">
          {values.map((value) => (
            <article class="retro-value">
              <span aria-hidden="true" class="retro-value-number">{value.number}</span>
              <h3>{value.title}</h3>
              <p>{value.description}</p>
            </article>
          ))}
        </div>
        <a href="/tujuan" class="retro-button retro-button-red retro-centered-button">Lihat Tujuan Koperasi</a>
      </div>
    </section>

    <section id="gerai" class="retro-section retro-section-paper" aria-labelledby="units-heading">
      <div class="retro-page-container">
        <p class="retro-eyebrow retro-center">Melayani Kebutuhan Desa</p>
        <h2 id="units-heading" class="retro-section-title retro-center">Gerai &amp; Layanan</h2>
        <p class="retro-section-intro">Ragam layanan berikut merupakan contoh unit usaha dalam program koperasi; ketersediaannya berbeda di setiap lokasi.</p>
        <div class="retro-unit-grid">
          {units.map((unit, index) => (
            <a href={unit.url} class="retro-unit">
              <span class="retro-unit-number">{String(index + 1).padStart(2, '0')}</span>
              <h3>{unit.title}</h3>
              <p>{unit.description}</p>
              <span class="retro-unit-link">Pelajari selengkapnya <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="galeri" class="retro-section retro-section-gallery" aria-labelledby="gallery-heading">
      <div class="retro-page-container">
        <p class="retro-eyebrow retro-center">Dari Berbagai Daerah</p>
        <h2 id="gallery-heading" class="retro-section-title retro-center">Galeri Koperasi</h2>
        <p class="retro-section-intro">Dokumentasi kegiatan dan gerai Koperasi Merah Putih sungguhan dari berbagai daerah di Indonesia.</p>
        <div class="retro-gallery-grid">
          {featuredPhotos.map((photo) => (
            <figure class="retro-gallery-item">
              <a href={photo.source} target="_blank" rel="noopener noreferrer" aria-label={'Lihat sumber foto ' + photo.title}>
                <img
                  src={photo.image}
                  alt={photo.alt}
                  data-documented-image
                  data-fallback-src={storefrontHero.image}
                  data-fallback-alt={storefrontHero.alt}
                  data-fallback-source={storefrontHero.source}
                  data-fallback-credit={storefrontHero.credit}
                  width="720"
                  height="480"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <figcaption>
                <strong>{photo.title}</strong>
                <span>{photo.caption}</span>
                <a href={photo.source} target="_blank" rel="noopener noreferrer">Sumber: {photo.credit}</a>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="retro-section retro-join" aria-labelledby="join-heading">
      <div class="retro-page-container retro-join-inner">
        <p class="retro-eyebrow retro-center">Mari Tumbuh Bersama</p>
        <h2 id="join-heading" class="retro-section-title retro-center">Jadi Bagian dari Desa yang Berdaya!</h2>
        <p>Kenali hak dan kewajiban anggota koperasi, lalu hubungi pengurus koperasi di desa Anda untuk informasi pendaftaran yang terverifikasi.</p>
        <div class="retro-actions">
          <a href="/keanggotaan" class="retro-button retro-button-red">Info Keanggotaan</a>
          <a href="/lokasi" class="retro-button retro-button-outline">Lokasi &amp; Kontak</a>
        </div>
      </div>
    </section>
  </div>

  <Footer />
  <script>
    // Publishers may refuse hotlinked images. Keep the layout populated with a
    // verified alternate documentary photograph rather than a misleading blank.
    const documentaryImages = document.querySelectorAll<HTMLImageElement>('img[data-documented-image]');

    for (const image of documentaryImages) {
      const applyFallback = () => {
        if (image.dataset.fallbackApplied === 'true') return;

        const source = image.dataset.fallbackSrc;
        if (!source) return;

        image.dataset.fallbackApplied = 'true';
        image.src = source;
        image.alt = image.dataset.fallbackAlt ?? 'Foto dokumentasi gerai Koperasi Merah Putih Bentangan';

        const credit = image.dataset.fallbackCredit ?? 'Penerbit dokumentasi';
        const sourceLink = image.dataset.fallbackSource ?? '';
        const caption = image.closest('figure')?.querySelector('figcaption');

        if (!caption) return;

        const name = document.createElement('strong');
        name.textContent = 'Foto alternatif: KDMP Bentangan';
        const place = document.createElement('span');
        place.textContent = 'Foto sumber utama tidak tersedia';
        const link = document.createElement('a');
        link.href = sourceLink;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = 'Sumber: ' + credit;
        caption.replaceChildren(name, place, link);

        const parentLink = image.closest('a');
        if (parentLink) parentLink.href = sourceLink;
      };

      image.addEventListener('error', applyFallback, { once: true });
      if (image.complete && image.naturalWidth === 0) applyFallback();
    }
  </script>
</Layout>
