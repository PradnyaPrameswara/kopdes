---
// src/pages/tujuan.astro
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/sections/Header.astro';
import PageIntro from '@/components/sections/PageIntro.astro';
import Objectives from '@/components/sections/Objectives.astro';
import Footer from '@/components/sections/Footer.astro';
import { siteConfig } from '@/data/site.config';
---

<Layout
  title={`Tujuan & Sasaran Strategis - ${siteConfig.name}`}
  description="Gambaran potensi pengembangan koperasi, prinsip tata kelola anggota, dan sumber aturan yang perlu diperiksa."
>
  <Header />

  <PageIntro title="Budaya & Nilai Kami" description="Gotong royong, keterbukaan, dan kerja sama sebagai dasar kemajuan ekonomi desa." />

  <Objectives />

  <!-- CTA Banner to Register -->
  <section class="py-12 bg-white border-t border-border">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-black text-[#065366]">Dukung Kedaulatan Ekonomi Desa Anda</h2>
      <p class="mt-2 text-sm sm:text-base text-muted">Daftarkan diri Anda hari ini untuk menjadi bagian dari gerakan gotong royong Koperasi Merah Putih.</p>
      <div class="mt-6 flex justify-center gap-3">
        <a href="/daftar" class="inline-flex items-center gap-2 px-6 py-3 rounded-[10px] bg-[#065366] hover:bg-[#044352] text-white font-bold text-sm shadow-xs transition-colors">
          <span>Daftar Keanggotaan</span>
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
