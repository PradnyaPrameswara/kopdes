---
// src/pages/faq.astro
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/sections/Header.astro';
import { FaqAccordion } from '@/components/islands/FaqAccordion';
import Footer from '@/components/sections/Footer.astro';
import { siteConfig } from '@/data/site.config';
---

<Layout
  title={`Tanya Jawab (FAQ) - ${siteConfig.name}`}
  description="Pertanyaan dan jawaban seputar keanggotaan, pembagian SHU, belanja sembako, dan layanan Koperasi Merah Putih."
>
  <Header />

  <div class="py-6 bg-surface border-b border-border/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-muted" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-red transition-colors">Beranda</a>
        <span>/</span>
        <span class="text-ink font-semibold">Tanya Jawab (FAQ)</span>
      </nav>
    </div>
  </div>

  <section class="py-14 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-brand-red/20 bg-surface text-brand-red text-xs font-semibold mb-3 shadow-2xs">
          <span class="size-2 rounded-full bg-brand-red"></span>
          <span>Pusat Bantuan &amp; Informasi</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-[#065366] tracking-tight">
          Pertanyaan Umum (FAQ)
        </h1>
        <p class="mt-3 text-sm sm:text-base md:text-lg text-muted leading-relaxed">
          Temukan jawaban seputar pendaftaran anggota, hak pembagian SHU, mekanisme belanja sembako murah, dan fasilitas kesehatan desa.
        </p>
      </div>

      <FaqAccordion client:visible />
    </div>
  </section>

  <Footer />
</Layout>
