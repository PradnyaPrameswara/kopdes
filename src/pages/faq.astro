---
// src/pages/faq.astro
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/sections/Header.astro';
import PageIntro from '@/components/sections/PageIntro.astro';
import { FaqAccordion } from '@/components/islands/FaqAccordion';
import Footer from '@/components/sections/Footer.astro';
import { siteConfig } from '@/data/site.config';
---

<Layout
  title={`Tanya Jawab (FAQ) - ${siteConfig.name}`}
  description="Jawaban umum mengenai keanggotaan, unit usaha, SHU, dan layanan program tanpa menjanjikan manfaat operasional tertentu."
>
  <Header />

  <PageIntro title="Tanya Jawab" description="Pertanyaan umum seputar prinsip, layanan, dan keanggotaan Koperasi Merah Putih." />

  <section class="py-14 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-brand-red/20 bg-surface text-brand-red text-xs font-semibold mb-3 shadow-2xs">
          <span class="size-2 rounded-full bg-brand-red"></span>
          <span>Pusat Bantuan &amp; Informasi</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-black text-[#065366] tracking-tight">
          Pertanyaan Umum (FAQ)
        </h2>
        <p class="mt-3 text-sm sm:text-base md:text-lg text-muted leading-relaxed">
          Temukan panduan umum mengenai keanggotaan, SHU, contoh jenis unit usaha, dan informasi yang harus diverifikasi kepada pengurus koperasi setempat.
        </p>
      </div>

      <FaqAccordion client:visible />
    </div>
  </section>

  <Footer />
</Layout>
