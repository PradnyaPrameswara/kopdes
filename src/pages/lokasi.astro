---
// src/pages/lokasi.astro
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/sections/Header.astro';
import PageIntro from '@/components/sections/PageIntro.astro';
import Location from '@/components/sections/Location.astro';
import Footer from '@/components/sections/Footer.astro';
import { siteConfig } from '@/data/site.config';
---

<Layout
  title={`Lokasi & Informasi - ${siteConfig.name}`}
  description="Panduan menemukan pengurus koperasi dan memeriksa sumber program yang terverifikasi; situs konsep tidak menyediakan alamat maupun nomor kontak gerai."
>
  <Header />

  <PageIntro title="Lokasi & Kontak" description="Informasi pelayanan koperasi perlu diverifikasi langsung dengan pengurus di daerah masing-masing." />

  <Location />

  <Footer />
</Layout>
