---
// src/pages/lokasi.astro
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/sections/Header.astro';
import Location from '@/components/sections/Location.astro';
import Footer from '@/components/sections/Footer.astro';
import { siteConfig } from '@/data/site.config';
---

<Layout
  title={`Lokasi & Jam Pelayanan - ${siteConfig.name}`}
  description="Alamat kantor sentra pelayanan Koperasi Merah Putih, jadwal operasional gerai sembako, dan kontak WhatsApp resmi pengurus desa."
>
  <Header />

  <div class="py-6 bg-surface border-b border-border/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-muted" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-red transition-colors">Beranda</a>
        <span>/</span>
        <span class="text-ink font-semibold">Lokasi &amp; Kontak</span>
      </nav>
    </div>
  </div>

  <Location />

  <Footer />
</Layout>
