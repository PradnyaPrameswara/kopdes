---
// src/pages/lokasi.astro
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/sections/Header.astro';
import PageIntro from '@/components/sections/PageIntro.astro';
import Location from '@/components/sections/Location.astro';
import Footer from '@/components/sections/Footer.astro';
import { siteConfig } from '@/data/site.config';
---

<Layout
  title={`Lokasi & Jam Pelayanan - ${siteConfig.name}`}
  description="Alamat kantor sentra pelayanan Koperasi Merah Putih, jadwal operasional gerai sembako, dan kontak WhatsApp resmi pengurus desa."
>
  <Header />

  <PageIntro title="Lokasi & Kontak" description="Informasi pelayanan koperasi perlu diverifikasi langsung dengan pengurus di daerah masing-masing." />

  <Location />

  <Footer />
</Layout>
