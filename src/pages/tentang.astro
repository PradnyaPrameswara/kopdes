---
// src/pages/tentang.astro
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/sections/Header.astro';
import PageIntro from '@/components/sections/PageIntro.astro';
import About from '@/components/sections/About.astro';
import Footer from '@/components/sections/Footer.astro';
import { siteConfig } from '@/data/site.config';
---

<Layout
  title={`Tentang Program Koperasi - ${siteConfig.name}`}
  description="Mengenal program Koperasi Desa/Kelurahan Merah Putih, nilai gotong royong, dan petunjuk pembentukan pada JDIH Kementerian Koperasi."
>
  <Header />

  <PageIntro title="Sejarah Kami" description="Mengenal perjalanan dan tujuan gerakan koperasi desa dalam memperkuat ekonomi masyarakat." />

  <About />

  <Footer />
</Layout>
