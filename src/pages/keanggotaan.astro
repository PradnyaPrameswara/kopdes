---
// src/pages/keanggotaan.astro
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/sections/Header.astro';
import Membership from '@/components/sections/Membership.astro';
import Footer from '@/components/sections/Footer.astro';
import { siteConfig } from '@/data/site.config';
---

<Layout
  title={`Keanggotaan & Bagi Hasil SHU - ${siteConfig.name}`}
  description="Prosedur pendaftaran anggota, rincian simpanan pokok dan simpanan wajib, serta hak pembagian Sisa Hasil Usaha (SHU) tahunan secara tunai."
>
  <Header />

  <div class="py-6 bg-surface border-b border-border/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-muted" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-red transition-colors">Beranda</a>
        <span>/</span>
        <span class="text-ink font-semibold">Keanggotaan &amp; SHU</span>
      </nav>
    </div>
  </div>

  <Membership />

  <!-- Action CTA -->
  <section class="py-12 bg-white border-t border-border">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-black text-[#065366]">Siap Menjadi Anggota Pemilik Koperasi?</h2>
      <p class="mt-2 text-sm sm:text-base text-muted">Isi formulir pendaftaran online dalam 2 menit atau kunjungi kantor koperasi desa setempat.</p>
      <div class="mt-6 flex justify-center gap-3">
        <a href="/daftar" class="inline-flex items-center gap-2 px-6 py-3 rounded-[10px] bg-[#065366] hover:bg-[#044352] text-white font-bold text-sm shadow-xs transition-colors">
          <span>Isi Formulir Pendaftaran Sekarang</span>
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
