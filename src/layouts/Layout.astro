---
import '../styles/global.css';
import '../styles/retro.css';
import { siteConfig } from '@/data/site.config';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title = `${siteConfig.name} - ${siteConfig.tagline}`,
  description = siteConfig.description,
  image = '/images/brand/logo-kopdes.webp',
  canonicalURL = Astro.url.href,
  type = 'website',
  // This remains an independent concept; publication requires separate authorization.
  noindex = true,
} = Astro.props;

const siteUrl = import.meta.env.SITE ?? siteConfig.meta.siteUrl;
const siteRoot = new URL(import.meta.env.BASE_URL, siteUrl);
const fullImageUrl = image.startsWith('http') ? image : new URL(image.replace(/^[/]+/, ''), siteRoot).href;

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  description: siteConfig.description,
  inLanguage: 'id-ID',
  url: siteRoot.href,
};
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="alternate icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="KOPDES independent concept" />
    <meta name="theme-color" content={siteConfig.meta.themeColor} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:alt" content="Koperasi Merah Putih — identitas situs informasi independen" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={siteConfig.meta.locale} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullImageUrl} />

    <!-- JSON-LD Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  </head>
  <body class="retro-site min-h-screen bg-background text-foreground antialiased selection:bg-brand-red selection:text-white">
    <!-- Accessible Skip Link to Main Content -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-3 focus:bg-brand-red focus:text-white focus:rounded-md focus:shadow-xl focus:outline-none focus:ring-2 focus:ring-gold"
    >
      Langsung ke Konten Utama
    </a>

    <div class="relative flex min-h-screen flex-col overflow-x-hidden">
      <main id="main-content" class="flex-1">
        <slot />
      </main>
    </div>
  </body>
</html>
