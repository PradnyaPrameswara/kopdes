---
// src/components/sections/Outlets.astro
import { outlets } from "@/data/outlets";
---

<section id="gerai" class="py-16 md:py-24 bg-white relative border-b border-neutral-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-brand-red/20 bg-surface text-brand-red text-xs font-semibold mb-3 shadow-2xs">
        <span class="size-2 rounded-full bg-brand-red"></span>
        <span>Ekosistem Ritel & Layanan Desa</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-[#065366] tracking-tight">
        Unit Usaha Koperasi Merah Putih
      </h2>
      <p class="mt-3 text-sm sm:text-base md:text-lg text-muted leading-relaxed">
        Contoh jenis usaha yang dapat dikembangkan koperasi. Ketersediaan, izin, harga, dan jam operasional harus dikonfirmasi kepada koperasi setempat.
      </p>
    </div>

    <!-- Structured Tactical Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {outlets.map((outlet) => {
        const isActive = outlet.status === "active";
        return (
          <div class="border border-border/80 hover:border-[#065366]/30 bg-white rounded-[20px] shadow-2xs hover:shadow-md transition-all duration-200 flex flex-col justify-between overflow-hidden group">
            <div class="p-5 sm:p-6">
              <!-- Header Bar -->
              <div class="flex items-center justify-between gap-2 pb-3 mb-4 border-b border-border/60">
                <span class="text-xs font-semibold uppercase tracking-wider text-muted">
                  {outlet.tag}
                </span>
                {isActive ? (
                  <span class="inline-flex items-center gap-1.5 text-xs font-bold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Beroperasi
                  </span>
                ) : (
                  <span class="inline-flex items-center text-xs font-medium px-2.5 py-0.5 rounded-full bg-neutral-100 text-neutral-600 border border-neutral-200">
                    Contoh Unit Usaha
                  </span>
                )}
              </div>
              <!-- Icon & Title -->
              <div class="flex items-start gap-4 mb-3">
                <div class="size-11 rounded-md bg-surface border border-brand-red/20 flex items-center justify-center text-brand-red shrink-0 group-hover:bg-brand-red group-hover:text-white transition-colors duration-200">
                  {outlet.icon === "shopping-bag" && (
                    <svg class="size-5.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
                    </svg>
                  )}
                  {outlet.icon === "pill" && (
                    <svg class="size-5.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"/><path d="m8.5 8.5 7 7"/>
                    </svg>
                  )}
                  {outlet.icon === "stethoscope" && (
                    <svg class="size-5.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/><path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"/><circle cx="20" cy="10" r="2"/>
                    </svg>
                  )}
                  {outlet.icon === "snowflake" && (
                    <svg class="size-5.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <line x1="2" x2="22" y1="12" y2="12"/><line x1="12" x2="12" y1="2" y2="22"/><path d="m20 16-4-4 4-4"/><path d="m4 8 4 4-4 4"/><path d="m16 4-4 4-4-4"/><path d="m8 20 4-4 4 4"/>
                    </svg>
                  )}
                  {outlet.icon === "truck" && (
                    <svg class="size-5.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-5l-3-4h-5v10Z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>
                    </svg>
                  )}
                  {outlet.icon === "building" && (
                    <svg class="size-5.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect width="16" height="20" x="4" y="2" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M8 10h.01"/><path d="M16 10h.01"/><path d="M8 14h.01"/><path d="M16 14h.01"/>
                    </svg>
                  )}
                  {outlet.icon === "sprout" && (
                    <svg class="size-5.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 20h10"/><path d="M10 20c5.5-2.5.8-6.4 3-13"/><path d="M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8z"/><path d="M14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z"/>
                    </svg>
                  )}
                </div>
                <div>
                  <h3 class="text-lg font-bold text-ink leading-snug">
                    {outlet.name}
                  </h3>
                  <p class="text-xs text-muted mt-1 leading-relaxed">
                    {outlet.description}
                  </p>
                </div>
              </div>

              <!-- Feature Highlights -->
              {outlet.highlights && outlet.highlights.length > 0 && (
                <div class="mt-4 pt-3 border-t border-neutral-100">
                  <div class="text-[11px] font-mono font-semibold uppercase text-neutral-400 mb-2">
                    Contoh Manfaat:
                  </div>
                  <ul class="space-y-1.5 text-xs text-ink/80">
                    {outlet.highlights.map((item) => (
                      <li class="flex items-center gap-2">
                        <span class="size-1.5 bg-brand-red rounded-xs shrink-0"></span>
                        <span class="font-medium">{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            <!-- Operating Hours Footer -->
            {outlet.operatingHours && (
              <div class="px-6 py-3 bg-neutral-50/80 border-t border-neutral-100 text-xs text-muted font-medium flex items-center justify-between">
                <span class="font-mono text-[11px] text-neutral-400 uppercase">Jadwal:</span>
                <div class="flex items-center gap-1.5 font-semibold text-ink/90">
                  <svg class="size-3.5 shrink-0 text-brand-red" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                  </svg>
                  <span>{outlet.operatingHours}</span>
                </div>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>
