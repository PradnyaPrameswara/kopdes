---
// src/components/sections/ClosingCTA.astro
import { siteConfig } from '@/data/site.config';
---

<section class="py-16 md:py-24 bg-brand-red text-white relative overflow-hidden">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <!-- Tactical Insignia Tag -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/15 backdrop-blur-xs text-white text-xs sm:text-sm font-semibold border border-white/20 mb-6">
      <span class="size-2 rounded-full bg-gold"></span>
      <span>Gotong Royong Membangun Ekonomi Desa</span>
    </div>

    <!-- Main Headline -->
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white max-w-4xl mx-auto leading-tight">
      Bangun Ekonomi Desa Bersama Koperasi Merah Putih
    </h2>

    <!-- Subtitle -->
    <p class="mt-5 text-base sm:text-lg text-white/90 max-w-2xl mx-auto leading-relaxed">
      Satu tekad memperkuat rantai pasok pangan, proteksi harga panen petani, serta ketersediaan sarana kesehatan terpadu. Daftarkan diri Anda sekarang sebagai anggota pemilik sah!
    </p>

    <!-- Action Buttons -->
    <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={`https://wa.me/${siteConfig.whatsappNumber}?text=Halo%20Pengurus%20Koperasi%20Merah%20Putih,%20saya%20siap%20mendaftar%20menjadi%20anggota`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-white text-brand-red font-bold text-sm sm:text-base hover:bg-neutral-50 shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 min-h-[48px]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.861.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
        </svg>
        <span>Daftar Sekarang via WhatsApp</span>
      </a>

      <a
        href="#lokasi"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-brand-red-dark hover:bg-brand-red-dark/90 text-white font-semibold text-sm sm:text-base border border-white/20 transition-all min-h-[48px]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>Kunjungi Sentra Layanan</span>
      </a>
    </div>

    <!-- Tactical Checkmarks -->
    <div class="mt-12 pt-8 border-t border-white/20 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs sm:text-sm font-medium text-white/90">
      <div class="flex items-center gap-2">
        <span class="size-4 rounded-xs bg-gold text-ink flex items-center justify-center shrink-0">
          <svg class="size-2.5 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </span>
        <span class="font-semibold uppercase tracking-wide">Badan Hukum Resmi Kemenkop RI</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="size-4 rounded-xs bg-gold text-ink flex items-center justify-center shrink-0">
          <svg class="size-2.5 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </span>
        <span class="font-semibold uppercase tracking-wide">Audit Finansial Terbuka &amp; Berkala</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="size-4 rounded-xs bg-gold text-ink flex items-center justify-center shrink-0">
          <svg class="size-2.5 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </span>
        <span class="font-semibold uppercase tracking-wide">Tata Kelola Musyawarah Mandiri Warga</span>
      </div>
    </div>
  </div>
</section>
