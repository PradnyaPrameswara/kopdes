---
interface Testimonial {
  name: string;
  role: string;
  village: string;
  quote: string;
  rating: number;
  avatarInitials: string;
  badge: string;
}

const testimonials: Testimonial[] = [
  {
    name: 'Pak Sugeng Riyadi',
    role: 'Petani Padi Organik',
    village: 'Dusun Sukamaju',
    quote:
      'Sejak ada cold storage dan gudang Koperasi Merah Putih, hasil panen gabah kami tidak lagi dipermainkan tengkulak. Pupuk NPK subsidi juga selalu tersedia tepat waktu dengan harga pasti. Ekonomi keluarga jauh lebih stabil.',
    rating: 5,
    avatarInitials: 'SR',
    badge: 'Anggota Petani',
  },
  {
    name: 'Ibu Ratna Dewi',
    role: 'Ibu Rumah Tangga & Anggota Simpanan',
    village: 'RT 04 / RW 02 Desa Makmur',
    quote:
      'Belanja sembako di gerai Koperasi Merah Putih harganya benar-benar murah, beras dan minyak goreng kualitasnya bagus. Anak demam tinggal ke klinik desa buka 24 jam. Setiap akhir tahun dapat pembagian SHU tunai.',
    rating: 5,
    avatarInitials: 'RD',
    badge: 'Anggota Konsumen',
  },
  {
    name: 'Mas Joko Prasetyo',
    role: 'Pelaku UMKM Keripik Singkong Desa',
    village: 'Sentra Olahan Pangan Desa',
    quote:
      'Produk olahan keripik saya dibantu masuk rak gerai sembako dan logistik desa bantu kirim ke kecamatan tetangga. Ditambah pinjaman modal usaha koperasi berbunga sangat ringan tanpa jaminan rumit.',
    rating: 5,
    avatarInitials: 'JP',
    badge: 'Mitra UMKM',
  },
];
---

<section id="testimoni" class="py-16 md:py-24 bg-surface/60 border-t border-b border-brand-red/10 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-brand-red/10 text-brand-red border border-brand-red/20 mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-brand-red" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <span>Cerita Warga & Anggota</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-ink tracking-tight">
        Manfaat Nyata untuk Warga Desa
      </h2>
      <p class="mt-3 text-sm sm:text-base text-muted">
        Dengarkan langsung penuturan petani, ibu rumah tangga, dan pelaku UMKM desa yang merasakan kemudahan layanan dan gotong royong Koperasi Merah Putih.
      </p>
    </div>

    <!-- Mobile Scroll-Snap Container & Desktop 3-Column Grid -->
    <div
      class="flex overflow-x-auto snap-x snap-mandatory gap-5 pb-6 pt-2 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:mx-0 lg:px-0 lg:grid lg:grid-cols-3 lg:overflow-visible lg:pb-0 scrollbar-none"
      style="scroll-padding: 1rem; -webkit-overflow-scrolling: touch;"
      role="region"
      aria-label="Daftar Testimoni Warga"
    >
      {testimonials.map((item) => (
        <article
          class="shrink-0 w-[84vw] max-w-sm sm:w-[360px] lg:w-auto snap-center bg-white rounded-2xl p-6 sm:p-7 shadow-sm border border-neutral-200/80 hover:border-brand-red/30 hover:shadow-md transition-all flex flex-col justify-between"
        >
          <div>
            <!-- Star Ratings & Badge -->
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-1" aria-label={`Rating ${item.rating} dari 5 bintang`}>
                {Array.from({ length: item.rating }).map(() => (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4 text-gold fill-gold"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
                ))}
              </div>
              <span class="text-xs font-medium px-2.5 py-0.5 rounded-full bg-surface text-brand-red border border-brand-red/15">
                {item.badge}
              </span>
            </div>

            <!-- Quote Text -->
            <blockquote class="text-ink/90 text-sm sm:text-base leading-relaxed italic mb-6">
              &ldquo;{item.quote}&rdquo;
            </blockquote>
          </div>

          <!-- Author Info -->
          <div class="pt-4 border-t border-neutral-100 flex items-center gap-3.5">
            <div
              class="w-11 h-11 rounded-full bg-brand-red text-white font-bold flex items-center justify-center text-sm shrink-0 shadow-inner"
              aria-hidden="true"
            >
              {item.avatarInitials}
            </div>
            <div>
              <h3 class="font-bold text-ink text-sm sm:text-base leading-tight">
                {item.name}
              </h3>
              <p class="text-xs text-muted mt-0.5">
                {item.role} &bull; <span class="text-neutral-500">{item.village}</span>
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Mobile Scroll Cue -->
    <div class="lg:hidden flex items-center justify-center gap-1 text-xs text-muted mt-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-red animate-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m9 18 6-6-6-6"></path>
      </svg>
      <span>Geser untuk melihat testimoni lainnya</span>
    </div>
  </div>
</section>
