---
// src/components/sections/Membership.astro
import { siteConfig } from "@/data/site.config";

const steps = [
  {
    step: "01",
    code: "TAHAP-01",
    title: "Verifikasi KTP & Domisili Desa",
    subtitle: "Validasi Kependudukan Resmi",
    description:
      "Wajib berstatus warga yang berdomisili di wilayah desa setempat dengan verifikasi dokumen KTP elektronik dan Kartu Keluarga (KK) sah oleh petugas administrasi.",
    icon: "id-card",
  },
  {
    step: "02",
    code: "TAHAP-02",
    title: "Registrasi Administrasi Terpadu",
    subtitle: "Pencatatan Mandiri & Terverifikasi",
    description:
      "Pengisian berkas registrasi keanggotaan terintegrasi secara langsung di Sentra Kantor Koperasi atau melalui kanal digital koordinasi resmi WhatsApp.",
    icon: "clipboard-list",
  },
  {
    step: "03",
    code: "TAHAP-03",
    title: "Kontribusi Simpanan Pokok & Wajib",
    subtitle: "Kedaulatan Permodalan Kolektif",
    description:
      "Penyetoran simpanan pokok (satu kali registrasi awal) dan simpanan wajib bulanan terjangkau yang telah dimufakati dalam forum musyawarah Rapat Anggota.",
    icon: "wallet",
  },
];

const sovereignRights = [
  {
    tag: "HAK EKONOMI",
    title: "Dividen SHU Tahunan Terukur",
    description: "Menerima pembagian Sisa Hasil Usaha (SHU) setiap tahun secara transparan, dihitung proporsional berbasis keaktifan transaksi dan simpanan.",
  },
  {
    tag: "HAK PROTOKOL PANGAN",
    title: "Prioritas Subsidi Logistik & Obat",
    description: "Hak harga anggota lebih murah untuk komoditas pangan sembako serta kepastian akses pasokan obat-obatan esensial di apotek desa.",
  },
  {
    tag: "HAK LOGISTIK TANI",
    title: "Jaminan Penyerapan Panen Tani",
    description: "Akses proteksi harga dasar panen hortikultura dan kuota fasilitas cold storage berpendingin guna mencegah anjloknya nilai jual hasil bumi.",
  },
  {
    tag: "HAK SUARA DEMOKRATIS",
    title: "Satu Anggota Satu Suara (RAT)",
    description: "Kedaulatan mutlak dalam menentukan pengawas, evaluasi laporan keuangan, serta pengesahan rencana strategis pada Rapat Anggota Tahunan.",
  },
];

const waRegisterUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(
  "Halo Pengurus Koperasi Merah Putih, saya ingin mendaftar sebagai anggota koperasi dan menanyakan prosedur simpanan."
)}`;
---

<section id="keanggotaan" class="py-16 md:py-24 bg-white relative border-b border-neutral-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-brand-red/20 bg-surface text-brand-red text-xs font-semibold mb-3 shadow-2xs">
        <span class="size-2 rounded-full bg-brand-red"></span>
        <span>Langkah Mudah Bergabung</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-[#065366] tracking-tight">
        Cara Menjadi Anggota Koperasi Merah Putih
      </h2>
      <p class="mt-3 text-sm sm:text-base md:text-lg text-muted leading-relaxed">
        Menjadi pemilik sekaligus penerima manfaat kemajuan ekonomi desa hanya dalam 3 langkah sederhana dan transparan.
      </p>
    </div>

    <!-- 3 Disciplined Sequential Steps -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 relative mb-16">
      {steps.map((item, idx) => (
        <div class="relative bg-white rounded-[20px] p-6 sm:p-8 border border-border/80 hover:border-[#065366]/30 shadow-2xs hover:shadow-md transition-all duration-200 flex flex-col justify-between group">
          <div>
            <!-- Step Header Bar -->
            <div class="flex items-center justify-between pb-4 mb-5 border-b border-border/60">
              <span class="text-xs font-bold uppercase tracking-wider text-muted">
                Tahap {idx + 1}
              </span>
              <span class="inline-flex items-center justify-center size-9 rounded-full bg-brand-red text-white font-bold text-sm shadow-xs">
                {item.step}
              </span>
            </div>
            <!-- Icon & Subtitle -->
            <div class="flex items-center gap-3 mb-3">
              <div class="size-10 rounded-md bg-surface border border-brand-red/20 flex items-center justify-center text-brand-red shrink-0">
                {item.icon === "id-card" && (
                  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="18" height="14" x="3" y="5" rx="2"/><path d="M7 15h4M15 15h2M7 11h2M7 7h10"/>
                  </svg>
                )}
                {item.icon === "clipboard-list" && (
                  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/>
                  </svg>
                )}
                {item.icon === "wallet" && (
                  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>
                  </svg>
                )}
              </div>
              <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-muted">
                {item.subtitle}
              </span>
            </div>

            <!-- Title & Description -->
            <h3 class="text-xl font-bold text-ink mb-3 leading-snug">
              {item.title}
            </h3>
            <p class="text-sm text-muted leading-relaxed">
              {item.description}
            </p>
          </div>

          <!-- Step Action Helper -->
          <div class="mt-6 pt-4 border-t border-border/60 flex items-center justify-between text-xs text-muted">
            <span class="font-medium">Waktu Verifikasi:</span>
            <span class="font-bold text-brand-red">Langsung Selesai di Tempat</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Structured Callout Card on Member Sovereign Rights & SHU Dividends -->
    <div class="rounded-lg bg-neutral-900 border-2 border-brand-red/30 p-8 sm:p-12 text-white shadow-xl relative overflow-hidden">
      <!-- Tactical Grid Accent -->
      <div class="absolute inset-0 opacity-5 pointer-events-none" style="background-image: linear-gradient(to right, #ffffff 1px, transparent 1px), linear-gradient(to bottom, #ffffff 1px, transparent 1px); background-size: 32px 32px;" aria-hidden="true"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left: Sovereign Mandate & Action -->
        <div class="lg:col-span-5 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-xs bg-brand-red/30 border border-brand-red text-white text-xs font-mono font-bold tracking-wider uppercase">
            <span>KEDAULATAN EKONOMI DESA</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight leading-snug">
            Hak Berdaulat Anggota &amp; Dividen SHU Tahunan
          </h3>
          <p class="text-sm sm:text-base text-neutral-300 leading-relaxed">
            Setiap anggota Koperasi Merah Putih berkedudukan sah sebagai pemilik bersama. Keikutsertaan Anda memperkuat ketahanan pangan desa sekaligus menghasilkan dividen nyata setiap tutup buku tahunan.
          </p>

          <div class="pt-2">
            <a
              href={waRegisterUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-6 py-3.5 rounded-sm bg-brand-red hover:bg-brand-red-dark text-white font-bold text-sm sm:text-base tracking-wide shadow-md transition-colors min-h-[44px] gap-2.5 border border-white/20"
            >
              <span>DAFTAR REGISTRASI VIA WHATSAPP</span>
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Right: 4 Sovereign Benefits -->
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {sovereignRights.map((item) => (
            <div class="bg-neutral-800/80 border border-neutral-700 hover:border-brand-red/50 rounded-md p-5 transition-colors">
              <div class="flex items-center justify-between mb-2">
                <span class="font-mono text-[10px] font-bold text-gold tracking-widest uppercase">
                  {item.tag}
                </span>
                <svg class="size-4 text-gold shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </div>
              <h4 class="text-sm font-bold text-white mb-1.5 leading-snug">
                {item.title}
              </h4>
              <p class="text-xs text-neutral-300 leading-relaxed">
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
