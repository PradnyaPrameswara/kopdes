---
const steps = [
  { number: '01', title: 'Temukan koperasi yang terverifikasi', description: 'Konfirmasikan lokasi serta identitas pengurus melalui pemerintah desa atau kelurahan.' },
  { number: '02', title: 'Pelajari anggaran dasar', description: 'Tanyakan hak, kewajiban, dokumen, syarat simpanan, dan proses penerimaan anggota sebelum menyerahkan informasi pribadi.' },
  { number: '03', title: 'Ikuti prosedur koperasi setempat', description: 'Ajukan keanggotaan hanya melalui mekanisme resmi pengurus yang berwenang; minta bukti tertulis jika ada transaksi.' },
];

const principles = [
  { title: 'Partisipasi Anggota', description: 'Keputusan strategis dibuat sesuai tata kelola koperasi dan mekanisme rapat anggota.' },
  { title: 'Transparansi', description: 'Anggota dapat menanyakan laporan pengelolaan dan ketentuan keuangan berdasarkan haknya.' },
  { title: 'SHU Sesuai Ketentuan', description: 'Pembagian SHU tidak dijamin nominal atau waktunya; mengikuti kondisi dan keputusan koperasi.' },
];
---
<section id="keanggotaan" class="retro-section retro-section-paper" aria-labelledby="membership-heading">
  <div class="retro-page-container">
    <p class="retro-eyebrow retro-center">Panduan awal</p>
    <h2 id="membership-heading" class="retro-section-title retro-center">Menjadi Anggota Koperasi</h2>
    <p class="retro-section-intro">Keanggotaan dikelola oleh setiap koperasi. Panduan ini tidak menggantikan persyaratan dan anggaran dasar resmi.</p>
    <div class="retro-values-grid">
      {steps.map((step) => (
        <article class="retro-value">
          <span class="retro-value-number">{step.number}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </article>
      ))}
    </div>
    <div class="retro-unit-grid">
      {principles.map((item) => (
        <article class="retro-unit">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
    <div class="retro-actions mt-10">
      <a class="retro-button retro-button-red" href="/daftar">Panduan Pendaftaran</a>
      <a class="retro-button retro-button-outline" href="/faq">Tanya Jawab</a>
    </div>
    <p class="text-center mt-7 text-sm text-muted">Jangan mengirim NIK, foto KTP, atau uang ke kontak yang belum terverifikasi.</p>
  </div>
</section>
