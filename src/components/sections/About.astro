---
// src/components/sections/About.astro
import { Image } from "astro:assets";
import { siteConfig } from "@/data/site.config";
import presidenSalutePng from "@/assets/photos/presiden-prabowo-hormat.png";

const values = [
  {
    number: "01",
    title: "Transparansi & Gotong Royong",
    subtitle: "Kedaulatan Milik Anggota",
    description:
      "Koperasi dikelola secara terbuka dan demokratis. Setiap rupiah simpanan dan transaksi tercatat digital, dengan pembagian Sisa Hasil Usaha (SHU) tahunan yang adil bagi seluruh anggota terdaftar.",
    icon: "users",
  },
  {
    number: "02",
    title: "Harga Terjangkau Petani & Warga",
    subtitle: "Pangkas Margin Tengkulak",
    description:
      "Kami menghubungkan produsen utama dan distributor langsung ke rak gerai desa. Warga mendapatkan sembako murah, sementara petani memperoleh kepastian harga beli panen yang layak dan bermartabat.",
    icon: "trending-down",
  },
  {
    number: "03",
    title: "Distribusi Hasil Panen Langsung",
    subtitle: "Rantai Dingin & Logistik Cepat",
    description:
      "Didukung fasilitas cold storage berkapasitas 50 ton dan armada logistik desa berpendingin, hasil panen hortikultura dan ternak terlindungi dari pembusukan dan langsung terserap ke pasar induk regional.",
    icon: "truck",
  },
];
---

<section id="tentang" class="py-16 md:py-24 bg-surface border-y border-border relative overflow-hidden">
  <!-- Subtle decorative accents -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header: Vision & Mission Overview -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center mb-16">
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-brand-red/20 text-xs font-semibold text-brand-red mb-4 shadow-2xs">
          <span class="size-2 rounded-full bg-brand-red"></span>
          <span>Visi & Nilai Koperasi Merah Putih</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#065366] tracking-tight leading-tight">
          Kemandirian Ekonomi dari Desa: Berdaulat, Mandiri, dan Berkeadilan
        </h2>
        <p class="mt-4 text-base sm:text-lg text-muted leading-relaxed">
          {siteConfig.name} hadir sebagai wadah gotong royong seluruh warga desa. Bersama memotong rantai pasok tengkulak, menjaga stabilitas harga sembako, dan mewujudkan kesejahteraan keluarga desa secara adil dan transparan.
        </p>
      </div>

      <!-- Right Column: Presidential Statement / Quote Card with Circular Avatar -->
      <div class="lg:col-span-5 relative">
        <div class="relative bg-white rounded-[20px] p-6 sm:p-8 border border-border/80 shadow-md flex flex-col justify-between">
          <div class="flex items-center justify-between mb-5">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-red/10 text-brand-red text-xs font-bold border border-brand-red/20">
              <span class="size-1.5 rounded-full bg-brand-red"></span>
              Amanat Presiden Republik Indonesia
            </span>
            <svg class="size-8 text-brand-red/20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
            </svg>
          </div>

          <blockquote class="text-sm sm:text-base font-medium text-ink leading-relaxed italic mb-6 border-l-2 border-brand-red pl-4">
            "Koperasi Merah Putih adalah benteng pertahanan ekonomi rakyat. Dari desa kita wujudkan kedaulatan pangan, memutus ketergantungan pada tengkulak, dan memastikan setiap warga desa menikmati hasil kemakmuran negerinya sendiri."
          </blockquote>

          <div class="pt-5 border-t border-border flex items-center gap-4">
            <div class="relative flex size-16 sm:size-20 shrink-0 overflow-hidden rounded-full ring-4 ring-brand-red/25 shadow-md bg-neutral-100">
              <Image
                src={presidenSalutePng}
                alt="Presiden Republik Indonesia H. Prabowo Subianto"
                width={96}
                height={96}
                class="aspect-square size-full object-cover object-top"
                loading="lazy"
              />
            </div>
            <div>
              <h3 class="font-heading text-base sm:text-lg font-bold text-ink leading-snug">
                H. Prabowo Subianto
              </h3>
              <p class="text-xs font-semibold text-brand-red tracking-wide uppercase mt-0.5">
                Presiden Republik Indonesia
              </p>
              <p class="text-xs text-muted mt-0.5">
                Inisiator Gerakan 80.000 Koperasi Merah Putih
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3 Value Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {values.map((val) => (
        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-border/80 hover:border-brand-red/30 transition-all duration-200 flex flex-col justify-between shadow-2xs hover:shadow-md">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-xs font-semibold tracking-wider text-brand-red px-2.5 py-1 rounded-full bg-surface border border-brand-red/15">
                Prinsip {val.number}
              </span>
              <div class="size-10 rounded-xl bg-surface border border-brand-red/20 flex items-center justify-center text-brand-red">
                {val.icon === "users" && (
                  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                  </svg>
                )}
                {val.icon === "trending-down" && (
                  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="22 17 13.5 8.5 8.5 13.5 2 7"/><polyline points="16 17 22 17 22 11"/>
                  </svg>
                )}
                {val.icon === "truck" && (
                  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-5l-3-4h-5v10Z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>
                  </svg>
                )}
              </div>
            </div>
            <div class="text-xs font-bold uppercase tracking-wider text-muted mb-1">
              {val.subtitle}
            </div>
            <h3 class="text-xl font-extrabold text-ink mb-3 leading-snug">
              {val.title}
            </h3>
            <p class="text-sm text-muted leading-relaxed">
              {val.description}
            </p>
          </div>
          <div class="pt-5 mt-6 border-t border-border flex items-center gap-1.5 text-xs font-mono font-bold uppercase tracking-wider text-brand-red">
            <span>Standar Komando Nasional</span>
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
