---
// src/components/sections/Hero.astro
import { siteConfig } from "@/data/site.config";

const waRegisterUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(
  "Halo Pengurus Koperasi Merah Putih, saya warga desa ingin mendaftar menjadi anggota koperasi."
)}`;
---

<section id="beranda" class="relative flex min-h-[560px] w-full flex-col overflow-hidden md:min-h-[640px] lg:h-[760px] lg:min-h-0 bg-[#121212]">
  <!-- Real Store Background Image with High Quality Cover -->
  <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image:url(/images/photos/hero-toko-kopdes.jpg)"></div>

  <!-- Top Dark Gradient Overlay (matching SIMKOPDES 138px) -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[138px] bg-gradient-to-b from-[rgba(18,18,18,0.85)] to-transparent" aria-hidden="true"></div>

  <!-- Bottom Dark Gradient Overlay (matching SIMKOPDES 60%) -->
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[65%] bg-gradient-to-t from-[#121212] from-[15%] via-[#121212]/85 via-[45%] to-transparent" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto flex w-full max-w-7xl flex-1 flex-col justify-end px-4 pb-8 pt-16 md:px-6 md:pb-12 md:pt-24 lg:px-8">
    <div class="flex flex-col gap-6 md:gap-8 lg:flex-row lg:items-end lg:justify-between">
      <!-- Left Narrative Column (matching SIMKOPDES Hero block) -->
      <div class="max-w-[580px] text-white">
        <p class="text-xs font-semibold sm:text-sm md:text-lg tracking-wide text-white/90">
          Koperasi Desa/Kelurahan Merah Putih
        </p>

        <h1 class="mt-1 text-2xl font-bold leading-tight sm:text-3xl md:mt-2 md:text-4xl lg:text-5xl text-white tracking-tight">
          Bangun Ekonomi Desa<br/>Kokohkan Ekonomi Bangsa
        </h1>

        <p class="mt-3 text-xs sm:text-sm md:text-base text-white/80 leading-relaxed max-w-xl">
          Menyediakan sembako murah terjangkau, apotek dan klinik kesehatan desa, serta cold storage dan logistik hasil panen langsung dari petani ke pasar.
        </p>

        <!-- CTA Action Buttons -->
        <div class="mt-4 sm:mt-6 flex flex-wrap items-center gap-3">
          <a
            href={waRegisterUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-fit items-center gap-1.5 sm:gap-2 whitespace-nowrap rounded-[10px] bg-white px-4 py-2.5 text-xs sm:text-sm md:text-base font-bold text-[#121212] transition-colors hover:bg-white/90 shadow-md min-h-[44px]"
          >
            <span>Daftar Keanggotaan Koperasi</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-4 md:size-5" aria-hidden="true">
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </a>

          <a
            href="#tujuan"
            class="inline-flex w-fit items-center gap-2 whitespace-nowrap rounded-[10px] bg-white/15 backdrop-blur-md border border-white/30 px-4 py-2.5 text-xs sm:text-sm md:text-base font-semibold text-white transition-colors hover:bg-white/25 min-h-[44px]"
          >
            <span>Pelajari Sasaran &amp; Unit</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Live Metric Counters (matching SIMKOPDES Stats block) -->
      <div class="grid grid-cols-2 gap-2.5 sm:flex sm:flex-row sm:items-center sm:gap-4 md:gap-5 text-white pt-2 lg:pt-0">
        <div class="rounded-[15px] bg-white/10 backdrop-blur-md border border-white/20 p-3.5 sm:p-4 min-w-[110px] sm:min-w-[130px] flex flex-col justify-center">
          <span class="text-xl sm:text-2xl md:text-3xl font-extrabold text-white block">450+</span>
          <span class="text-[11px] sm:text-xs text-white/80 font-medium mt-0.5 block">Komoditas Pangan</span>
        </div>
        <div class="rounded-[15px] bg-white/10 backdrop-blur-md border border-white/20 p-3.5 sm:p-4 min-w-[110px] sm:min-w-[130px] flex flex-col justify-center">
          <span class="text-xl sm:text-2xl md:text-3xl font-extrabold text-white block">1.200+</span>
          <span class="text-[11px] sm:text-xs text-white/80 font-medium mt-0.5 block">Warga Anggota</span>
        </div>
        <div class="rounded-[15px] bg-white/10 backdrop-blur-md border border-white/20 p-3.5 sm:p-4 min-w-[110px] sm:min-w-[130px] flex flex-col justify-center">
          <span class="text-xl sm:text-2xl md:text-3xl font-extrabold text-white block">7 Gerai</span>
          <span class="text-[11px] sm:text-xs text-white/80 font-medium mt-0.5 block">Layanan Aktif</span>
        </div>
      </div>
    </div>
  </div>
</section>
