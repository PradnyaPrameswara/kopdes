---
// src/components/sections/Footer.astro
import { Image } from 'astro:assets';
import { siteConfig } from '@/data/site.config';
import logoWebp from '@/assets/brand/logo-kopdes.webp';

const quickLinks = [
  { href: '/', label: 'Beranda Koperasi' },
  { href: '/tujuan', label: 'Tujuan & Sasaran' },
  { href: '/gerai', label: 'Unit Usaha & Layanan' },
  { href: '/keanggotaan', label: 'Keanggotaan & SHU' },
  { href: '/tentang', label: 'Visi & Amanat Presiden' },
  { href: '/lokasi', label: 'Lokasi & Jam Buka' },
  { href: '/faq', label: 'Tanya Jawab (FAQ)' },
  { href: '/daftar', label: 'Pendaftaran Anggota (Sign Up)' },
];

const infoLinks = [
  { href: '#tentang', label: 'Amanat Presiden RI & Kemenkop' },
  { href: `https://wa.me/${siteConfig.whatsappNumber}?text=Halo%20Bantuan%20Koperasi%20Merah%20Putih,%20saya%20ingin%20bertanya`, label: 'Bantuan WhatsApp Resmi' },
  { href: '#keanggotaan', label: 'Syarat & Ketentuan Keanggotaan' },
  { href: '#tujuan', label: 'Kebijakan Dividen SHU Tahunan' },
  { href: '#lokasi', label: 'Layanan Darurat Klinik 24 Jam' },
];

const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-[#F2F3F7] text-[#121212] border-t border-neutral-300">
  <div class="mx-auto max-w-7xl px-4 py-12 md:px-6 md:py-16 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      <!-- Col 1: Tautan Cepat (2 Cols) -->
      <div class="lg:col-span-3">
        <h3 class="text-xl sm:text-2xl font-bold text-[#065366]">Tautan Cepat</h3>
        <ul class="mt-6 space-y-3.5 text-sm sm:text-base text-[#065366]">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="transition-colors hover:text-[#044352] hover:underline flex items-center gap-1.5"
              >
                <span>{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 2: Informasi (3 Cols) -->
      <div class="lg:col-span-3">
        <h3 class="text-xl sm:text-2xl font-bold text-[#065366]">Informasi</h3>
        <ul class="mt-6 space-y-3.5 text-sm sm:text-base text-[#065366] leading-relaxed">
          {infoLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="transition-colors hover:text-[#044352] hover:underline"
                target={link.href.startsWith('http') ? '_blank' : '_self'}
                rel={link.href.startsWith('http') ? 'noopener noreferrer' : ''}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Media Sosial & Helpdesk (3 Cols) -->
      <div class="lg:col-span-3">
        <h3 class="text-xl sm:text-2xl font-bold text-[#065366]">Media Sosial</h3>
        <div class="mt-6 flex flex-wrap gap-2.5">
          {siteConfig.socialLinks.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex size-10 items-center justify-center rounded-full border border-[#065366] text-[#065366] hover:bg-[#065366] hover:text-white transition-colors"
              aria-label={social.label}
            >
              {social.platform === 'instagram' && (
                <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
                </svg>
              )}
              {social.platform === 'facebook' && (
                <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                </svg>
              )}
              {social.platform === 'tiktok' && (
                <svg class="size-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                </svg>
              )}
              {social.platform === 'youtube' && (
                <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/>
                </svg>
              )}
            </a>
          ))}
        </div>

        <!-- Helpdesk WhatsApp Pill Button (matching SIMKOPDES Green Helpdesk Pill) -->
        <div class="mt-6">
          <a
            href={`https://wa.me/${siteConfig.whatsappNumber}?text=Halo%20Pengurus%20Koperasi%20Merah%20Putih,%20saya%20ingin%20berkonsultasi`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-[44px] w-full max-w-[220px] items-center overflow-hidden rounded-[50px] bg-[#A0BA3B] hover:bg-[#8EA632] text-white shadow-xs transition-colors"
          >
            <span class="flex h-[44px] w-[44px] shrink-0 items-center justify-center bg-black/10">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </span>
            <span class="flex-1 px-3 text-xs font-bold whitespace-nowrap">
              Bantuan WhatsApp
            </span>
          </a>
        </div>
      </div>

      <!-- Col 4: Satgas KDKMP Card (3 Cols - matching SIMKOPDES Satgas Card) -->
      <div class="lg:col-span-3">
        <h3 class="text-xl sm:text-2xl font-bold text-[#065366]">Satgas KDKMP</h3>
        <div class="mt-6 rounded-[20px] bg-white p-5 border border-neutral-200/80 shadow-xs">
          <div class="flex items-center gap-3">
            <div class="h-10 w-14 shrink-0 rounded-lg bg-surface p-1 flex items-center justify-center border border-brand-red/20">
              <Image
                src={logoWebp}
                alt="Logo Koperasi Merah Putih"
                width={48}
                height={34}
                class="w-full h-full object-contain"
              />
            </div>
            <div>
              <h4 class="text-sm font-bold text-[#065366] leading-tight">
                {siteConfig.shortName}
              </h4>
              <p class="text-[11px] text-[#454545] font-medium mt-0.5">
                {siteConfig.legalName}
              </p>
            </div>
          </div>

          <div class="mt-4 rounded-[15px] bg-[#F2F3F7] p-3 text-xs">
            <p class="font-bold text-[#065366]">Alamat Sentra Layanan</p>
            <p class="mt-1 text-[#454545] leading-relaxed">
              {siteConfig.address.street}, {siteConfig.address.village}, {siteConfig.address.district}, {siteConfig.address.regency}, {siteConfig.address.province} {siteConfig.address.postalCode}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar (matching SIMKOPDES bottom strip bg-[#EFEFEF]) -->
  <div class="w-full bg-[#EFEFEF] py-6 border-t border-neutral-300/80">
    <div class="mx-auto flex w-full max-w-7xl flex-col sm:flex-row items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
      <p class="text-center text-xs sm:text-sm font-bold text-[#065366] sm:text-left">
        &copy; {currentYear}. {siteConfig.name} &bull; Kementerian Koperasi Republik Indonesia
      </p>
      <div class="flex items-center gap-2">
        <span class="text-[11px] text-muted font-medium">Portal Resmi Manajemen Desa:</span>
        <a href="https://simkopdes.go.id/" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-[#065366] hover:underline">
          simkopdes.go.id
        </a>
      </div>
    </div>
  </div>
</footer>
