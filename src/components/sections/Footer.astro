---
import { Image } from 'astro:assets';
import logo from '@/assets/brand/logo-kopdes.webp';

const quickLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/tujuan', label: 'Tujuan Koperasi' },
  { href: '/gerai', label: 'Gerai & Layanan' },
  { href: '/keanggotaan', label: 'Keanggotaan' },
  { href: '/tentang', label: 'Tentang Kami' },
  { href: '/lokasi', label: 'Lokasi' },
  { href: '/faq', label: 'Tanya Jawab' },
  { href: '/daftar', label: 'Informasi Pendaftaran' },
];
---
<footer class="retro-footer">
  <div class="retro-footer-zigzag" aria-hidden="true"></div>
  <div class="retro-footer-inner">
    <div class="retro-footer-brand">
      <Image src={logo} alt="Lambang Koperasi Merah Putih" width={90} height={67} loading="lazy" />
      <div>
        <strong>Koperasi Merah Putih</strong>
        <span>Gotong royong, dari desa untuk Indonesia.</span>
      </div>
    </div>
    <nav aria-label="Navigasi footer" class="retro-footer-links">
      {quickLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="retro-footer-bottom">
      <p>© {new Date().getFullYear()} Koperasi Merah Putih · Konsep website independen</p>
      <p>Foto gerai merupakan dokumentasi dari lokasi yang disebutkan pada sumber, bukan bukti operasional dari alamat contoh di website ini. Potret Presiden digunakan dalam konteks informasi program, bukan dukungan atau pernyataan resmi.</p>
    </div>
  </div>
</footer>
