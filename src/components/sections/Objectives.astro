---
const objectives = [
  { title: 'Akses Kebutuhan Pokok', description: 'Gerai dapat membantu warga memperoleh kebutuhan sehari-hari sesuai kemampuan pengelola koperasi.' },
  { title: 'Pemasaran Hasil Pertanian', description: 'Koperasi berpotensi mempertemukan produsen dengan pembeli, apabila mekanisme usaha dan fasilitas tersedia.' },
  { title: 'Layanan Sesuai Kebutuhan', description: 'Apotek, gudang, atau logistik merupakan opsi unit usaha yang membutuhkan kemampuan serta izin terkait.' },
  { title: 'Tata Kelola Anggota', description: 'Keputusan kegiatan usaha dan pertanggungjawaban koperasi mengikuti peraturan serta anggaran dasar.' },
  { title: 'Ekonomi Lokal', description: 'Koperasi dapat menjadi sarana kolaborasi UMKM, petani, dan warga tanpa menjamin keuntungan tertentu.' },
];
---
<section id="tujuan" class="retro-section retro-section-paper" aria-labelledby="objectives-heading">
  <div class="retro-page-container">
    <p class="retro-eyebrow retro-center">Potensi dan arah pengembangan</p>
    <h2 id="objectives-heading" class="retro-section-title retro-center">Tujuan Koperasi Merah Putih</h2>
    <p class="retro-section-intro">Berikut contoh bidang pengembangan koperasi, bukan daftar fasilitas yang dipastikan sudah aktif di setiap wilayah.</p>
    <div class="retro-values-grid">
      {objectives.map((item, index) => (
        <article class="retro-value">
          <span class="retro-value-number">{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
    <div class="retro-actions">
      <a class="retro-button retro-button-red" href="/gerai">Jenis Unit Usaha</a>
      <a class="retro-button retro-button-outline" href="https://jdih.kop.go.id/doc/detail/doc-1168-v_peraturan" target="_blank" rel="noopener noreferrer">Petunjuk Pelaksanaan 2025</a>
    </div>
  </div>
</section>
