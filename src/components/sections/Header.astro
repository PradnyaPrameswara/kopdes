---
import { Image } from 'astro:assets';
import logo from '@/assets/brand/logo-kopdes.webp';
import { storefrontHero } from '@/data/visual-media';

// The reference has four large horizontal navigation items. Keep the utility routes in the footer.
const navigation = [
  { label: 'Sejarah Kami', href: '/tentang' },
  { label: 'Budaya & Nilai', href: '/tujuan' },
  { label: 'Gerai & Layanan', href: '/gerai' },
  { label: 'Galeri Kegiatan', href: '/#galeri' },
];

const membershipLink = { label: 'Daftar Anggota', href: '/daftar' };

const currentPath = Astro.url.pathname;
---
<header class="retro-header" id="beranda">
  <div class="retro-masthead">
    <img
      class="retro-masthead-photo"
      src={storefrontHero.image}
      style={`object-position: ${storefrontHero.objectPosition ?? 'center'}`}
      alt={storefrontHero.alt}
      width="720"
      height="480"
      decoding="async"
      fetchpriority="high"
    />
    <div class="retro-masthead-overlay" aria-hidden="true"></div>
    <div class="retro-masthead-inner">
      <a class="retro-brand-mark" href="/" aria-label="Koperasi Merah Putih, ke beranda">
        <span class="retro-brand-circle">
          <Image src={logo} alt="Lambang Koperasi Desa Merah Putih" width={130} height={100} loading="eager" />
        </span>
        <span class="retro-brand-name">
          <span class="retro-brand-topline">Koperasi Desa / Kelurahan</span>
          <span class="retro-brand-headline">Merah Putih</span>
          <span class="retro-brand-tagline">Dari Desa, Untuk Indonesia</span>
        </span>
      </a>
    </div>
    <a class="retro-hero-photo-credit" href={storefrontHero.source} target="_blank" rel="noopener noreferrer">Foto dokumentasi: {storefrontHero.credit}</a>
  </div>
  <nav class="retro-nav" aria-label="Navigasi utama">
    <div class="retro-nav-desktop">
      {navigation.map((link) => (
        <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
      ))}
    </div>
    <details class="retro-nav-mobile">
      <summary>Menu Koperasi <span class="retro-nav-chevron" aria-hidden="true"></span></summary>
      <div class="retro-nav-mobile-links">
        {navigation.map((link) => (
          <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
        ))}
        <a href={membershipLink.href}>{membershipLink.label}</a>
      </div>
    </details>
  </nav>
</header>
